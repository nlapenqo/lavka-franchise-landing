{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Токены дизайн-системы лендингов Яндекс Лавки. Уровень 1 — примитивы (color, font, radius, space, motion), уровень 2 — роли (text, bg, surface, border, action, type, shadow). Значения десктопа; ступени планшета и телефона — в $extensions.lavka.responsive. Источник: site/styles.css, docs/design-system.md.",
  "color": {
    "$type": "color",
    "navy": { "$value": "#1B3A6A" },
    "navy-deep": { "$value": "#152E56" },
    "blue": { "$value": "#00ADFF" },
    "blue-hover": { "$value": "#16B5FF" },
    "mid": { "$value": "#3E88C5" },
    "sky": { "$value": "#AAD9FC" },
    "card": { "$value": "#EAF3FC" },
    "light": { "$value": "#F2F7FC" },
    "line": { "$value": "#D7E6F5" },
    "dim": { "$value": "#5A749B" },
    "dim-dark": { "$value": "#A7BEE0" },
    "muted-dark": { "$value": "#C0D2EC" },
    "white": { "$value": "#FFFFFF" },
    "live": { "$value": "#FF6D2F", "$description": "Только точка статуса «набор открыт»" },
    "error": { "$value": "#DF5661" },
    "ok": { "$value": "#198754" },
    "alpha": {
      "white-05": { "$value": "rgba(255,255,255,0.05)", "$description": "Заливка карточки на тёмном" },
      "white-10": { "$value": "rgba(255,255,255,0.10)", "$description": "Плашка иконки на тёмном" },
      "white-35": { "$value": "rgba(255,255,255,0.35)", "$description": "Линии и обводки на тёмном" },
      "sky-22": { "$value": "rgba(167,190,224,0.22)", "$description": "Обводка карточки и разделители на тёмном" },
      "navy-06": { "$value": "rgba(27,58,106,0.06)" },
      "navy-11": { "$value": "rgba(27,58,106,0.11)" },
      "navy-28": { "$value": "rgba(14,41,78,0.28)" },
      "blue-12": { "$value": "rgba(0,173,255,0.12)" },
      "blue-35": { "$value": "rgba(0,173,255,0.35)" }
    }
  },
  "text": {
    "$type": "color",
    "primary": { "$value": "{color.navy}" },
    "secondary": { "$value": "{color.dim}" },
    "on-dark": { "$value": "{color.white}" },
    "secondary-on-dark": { "$value": "{color.dim-dark}" },
    "muted-on-dark": { "$value": "{color.muted-dark}" },
    "accent": { "$value": "{color.blue}", "$description": "Акцент в заголовке, цифры на тёмном, время в программе" }
  },
  "bg": {
    "$type": "color",
    "page": { "$value": "{color.white}" },
    "section-light": { "$value": "{color.light}" },
    "section-dark": { "$value": "{color.navy}", "$description": "Всегда со свечением" }
  },
  "surface": {
    "$type": "color",
    "card": { "$value": "{color.white}" },
    "tint": { "$value": "{color.card}", "$description": "Карточки и чипсы на белом, плашка-карусель" },
    "on-dark": { "$value": "{color.alpha.white-05}" }
  },
  "border": {
    "$type": "color",
    "default": { "$value": "{color.line}" },
    "on-dark": { "$value": "{color.alpha.sky-22}" }
  },
  "action": {
    "$type": "color",
    "primary": { "$value": "{color.blue}", "$description": "Одна голубая кнопка на экран. Голубая заливка — только кнопка или таб" },
    "primary-hover": { "$value": "{color.blue-hover}" },
    "secondary": { "$value": "{color.navy}" },
    "status-live": { "$value": "{color.live}" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "geo": { "$value": ["YS Geo", "Arial", "sans-serif"] },
      "cond": { "$value": ["YS Text Cond", "Arial", "sans-serif"], "$description": "Только legal" }
    },
    "weight": {
      "$type": "fontWeight",
      "black": { "$value": 900 },
      "heavy": { "$value": 800 },
      "medium": { "$value": 500 },
      "regular": { "$value": 400 },
      "light": { "$value": 300 }
    },
    "size": {
      "$type": "dimension",
      "display": { "$value": "110px", "$extensions": { "lavka.responsive": { "tablet": "80px", "mobile": "clamp(40px,12.3vw,50px)" } } },
      "h1": { "$value": "80px", "$extensions": { "lavka.responsive": { "tablet": "64px", "mobile": "38px" } } },
      "h2": { "$value": "48px", "$extensions": { "lavka.responsive": { "tablet": "40px", "mobile": "28px" } } },
      "h3": { "$value": "31px", "$extensions": { "lavka.responsive": { "tablet": "24px", "mobile": "22px" } } },
      "h4": { "$value": "24px", "$extensions": { "lavka.responsive": { "tablet": "22px", "mobile": "20px" } } },
      "lead": { "$value": "22px", "$extensions": { "lavka.responsive": { "tablet": "19px", "mobile": "18px" } } },
      "body": { "$value": "18px", "$extensions": { "lavka.responsive": { "tablet": "18px", "mobile": "16px" } } },
      "body-s": { "$value": "16px", "$extensions": { "lavka.responsive": { "tablet": "16px", "mobile": "15px" } } },
      "small": { "$value": "14px", "$extensions": { "lavka.responsive": { "tablet": "14px", "mobile": "13px" } } },
      "caption": { "$value": "12px", "$extensions": { "lavka.responsive": { "tablet": "12px", "mobile": "11px" } } },
      "legal": { "$value": "12px" },
      "num-xl": { "$value": "154px", "$extensions": { "lavka.responsive": { "tablet": "104px", "mobile": "96px" } } },
      "num-l": { "$value": "112px", "$extensions": { "lavka.responsive": { "tablet": "80px", "mobile": "64px" } } },
      "num": { "$value": "44px", "$extensions": { "lavka.responsive": { "tablet": "38px", "mobile": "34px" } } }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 0.9, "$description": "display, числа" },
      "h1": { "$value": 0.92 },
      "h2": { "$value": 0.95 },
      "heading": { "$value": 1.05, "$description": "h3, h4" },
      "lead": { "$value": 1.15 },
      "body": { "$value": 1.35 },
      "body-loose": { "$value": 1.45, "$description": "Длинные абзацы, ответы FAQ, legal" }
    },
    "letter-spacing": {
      "$type": "dimension",
      "display": { "$value": "-0.01em", "$description": "display, h1, числа" },
      "h2": { "$value": "-0.005em" },
      "none": { "$value": "0em" },
      "caps": { "$value": "0.08em", "$description": "caption капсом" }
    }
  },
  "type": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.display}", "fontWeight": "{font.weight.black}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.display}" } },
    "h1": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.h1}", "fontWeight": "{font.weight.black}", "lineHeight": "{font.line-height.h1}", "letterSpacing": "{font.letter-spacing.display}" } },
    "h2": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.h2}", "fontWeight": "{font.weight.heavy}", "lineHeight": "{font.line-height.h2}", "letterSpacing": "{font.letter-spacing.h2}" } },
    "h3": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.h3}", "fontWeight": "{font.weight.heavy}", "lineHeight": "{font.line-height.heading}", "letterSpacing": "{font.letter-spacing.none}" } },
    "h4": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.h4}", "fontWeight": "{font.weight.heavy}", "lineHeight": "{font.line-height.heading}", "letterSpacing": "{font.letter-spacing.none}" } },
    "lead": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.lead}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.lead}", "letterSpacing": "{font.letter-spacing.none}" } },
    "body": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.body}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.body}", "letterSpacing": "{font.letter-spacing.none}" } },
    "body-s": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.body-s}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.body}", "letterSpacing": "{font.letter-spacing.none}" } },
    "name": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.body-s}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.heading}", "letterSpacing": "{font.letter-spacing.none}" }, "$description": "Имя человека, лейбл кнопки" },
    "small": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.small}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.body}", "letterSpacing": "{font.letter-spacing.none}" } },
    "caption": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.caption}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.body}", "letterSpacing": "{font.letter-spacing.caps}", "textCase": "uppercase" } },
    "legal": { "$value": { "fontFamily": "{font.family.cond}", "fontSize": "{font.size.legal}", "fontWeight": "{font.weight.light}", "lineHeight": "{font.line-height.body-loose}", "letterSpacing": "{font.letter-spacing.none}" } },
    "num-xl": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.num-xl}", "fontWeight": "{font.weight.black}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.display}" } },
    "num-l": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.num-l}", "fontWeight": "{font.weight.black}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.display}" } },
    "num": { "$value": { "fontFamily": "{font.family.geo}", "fontSize": "{font.size.num}", "fontWeight": "{font.weight.black}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.display}" } }
  },
  "radius": {
    "$type": "dimension",
    "xl": { "$value": "32px", "$description": "Карточки, панели, плашки" },
    "l": { "$value": "24px", "$description": "Медиа; карточки на телефоне" },
    "m": { "$value": "20px", "$description": "Полосы, поля, плашка-пояснение" },
    "s": { "$value": "12px", "$description": "Тултип, плашка иконки" },
    "pill": { "$value": "999px" },
    "circle": { "$value": "50%" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "8px" },
    "2": { "$value": "12px" },
    "3": { "$value": "16px" },
    "4": { "$value": "24px", "$description": "Между карточками" },
    "5": { "$value": "32px", "$description": "Внутри карточки" },
    "6": { "$value": "40px", "$description": "Внутри большой карточки; поля на телефоне" },
    "7": { "$value": "56px", "$description": "После заголовка секции; секция → CTA" },
    "8": { "$value": "64px", "$description": "Секция на телефоне" },
    "9": { "$value": "96px", "$description": "Секция на планшете — 88" },
    "10": { "$value": "128px", "$description": "Секция на десктопе" }
  },
  "layout": {
    "$type": "dimension",
    "container": { "$value": "1164px" },
    "container-wide": { "$value": "1440px" },
    "gutter": { "$value": "48px", "$extensions": { "lavka.responsive": { "mobile": "40px" } } },
    "breakpoint-xl": { "$value": "1199px" },
    "breakpoint-l": { "$value": "1100px" },
    "breakpoint-m": { "$value": "1023px" },
    "breakpoint-s": { "$value": "767px" }
  },
  "shadow": {
    "$type": "shadow",
    "card": { "$value": { "offsetX": "0px", "offsetY": "6px", "blur": "12px", "spread": "0px", "color": "{color.alpha.navy-06}" } },
    "card-hover": { "$value": { "offsetX": "0px", "offsetY": "16px", "blur": "35px", "spread": "0px", "color": "{color.alpha.navy-11}" } },
    "float": { "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "40px", "spread": "0px", "color": "rgba(27,58,106,0.10)" } },
    "deep": { "$value": { "offsetX": "0px", "offsetY": "20px", "blur": "60px", "spread": "0px", "color": "{color.alpha.navy-28}" } },
    "cta": { "$value": { "offsetX": "0px", "offsetY": "10px", "blur": "30px", "spread": "0px", "color": "{color.alpha.blue-35}" } },
    "header": { "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "36px", "spread": "0px", "color": "rgba(14,34,65,0.28)" } },
    "focus-ring": { "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "4px", "color": "{color.alpha.blue-12}" } }
  },
  "motion": {
    "easing": {
      "$type": "cubicBezier",
      "default": { "$value": [0.22, 0.61, 0.36, 1] },
      "drum": { "$value": [0.18, 0.86, 0.24, 1], "$description": "Барабаны, одометр" },
      "slide": { "$value": [0.5, 0, 0.2, 1], "$description": "Слайды карусели" }
    },
    "duration": {
      "$type": "duration",
      "hover": { "$value": "200ms" },
      "reveal": { "$value": "600ms" },
      "slide": { "$value": "720ms" },
      "counter": { "$value": "2000ms" }
    },
    "reveal-offset": { "$type": "dimension", "$value": "28px" },
    "stagger": { "$type": "duration", "$value": "80ms" },
    "hover-lift": { "$type": "dimension", "$value": "4px", "$description": "Карточки −4px, кнопки −2px" }
  }
}
